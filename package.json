{
  "name": "javascript-academy",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.18"
    }
  },
  "type": "module",
  "scripts": {
    "build:runner": "node scripts/build-runner.mjs",
    "build:editor": "node scripts/build-editor.mjs",
    "predev": "npm run build:runner && npm run build:editor",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "prebuild": "npm run validate:content && npm run build:runner && npm run build:editor",
    "validate:content": "tsx scripts/validate-content.ts",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "es-module-lexer": "3.0.5",
    "lucide-react": "1.72.0",
    "mdast-util-from-markdown": "2.1.0",
    "monaco-editor": "0.57.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.32",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
