[
  {
    "id": "focus-board-tasks",
    "kind": "bindingStructure",
    "binding": "tasks",
    "expected": [
      {
        "id": 1,
        "title": "Вивчити JavaScript",
        "status": "У роботі",
        "priority": 2,
        "minutes": 25
      },
      {
        "id": 2,
        "title": "Перевірити план",
        "status": "Готово",
        "priority": 1,
        "minutes": 15
      },
      {
        "id": 3,
        "title": "Зробити перерву",
        "status": "Заплановано",
        "priority": 2,
        "minutes": 35
      }
    ],
    "feedback": "Звір три картки в порядку taskTitles. Кожній потрібні поля id, title, status, priority і minutes. ID, пріоритет та хвилини мають бути числами."
  },
  {
    "id": "third-task-id",
    "kind": "bindingEquals",
    "binding": "thirdTaskId",
